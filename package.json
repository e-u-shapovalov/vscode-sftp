{
  "name": "wireferry",
  "displayName": "WireFerry — SFTP & FTP Sync",
  "description": "%extension.description%",
  "version": "2.7.7",
  "publisher": "EvgeniiShapovalov",
  "author": "EvgeniiShapovalov (https://github.com/e-u-shapovalov)",
  "engines": {
    "vscode": "^1.66.0"
  },
  "bugs": {
    "url": "https://github.com/e-u-shapovalov/vscode-sftp/issues"
  },
  "homepage": "https://github.com/e-u-shapovalov/vscode-sftp/blob/develop/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-u-shapovalov/vscode-sftp.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ftp",
    "ftps",
    "ssh",
    "sync",
    "upload",
    "download",
    "deploy",
    "remote",
    "remote-edit",
    "file-sync",
    "wireferry"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:wireferry.config",
    "workspaceContains:.vscode/sftp.json",
    "workspaceContains:.vscode/wireferry.json"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wireferry",
          "title": "WireFerry",
          "icon": "resources/remote-explorer.svg"
        }
      ]
    },
    "views": {
      "wireferry": [
        {
          "id": "remoteExplorer",
          "name": "%view.remoteExplorer.name%",
          "when": "wireferry.enabled"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "WireFerry",
      "properties": {
        "wireferry.debug": {
          "type": "boolean",
          "default": false,
          "description": "%wireferry.debug.description%"
        },
        "wireferry.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": true,
          "description": "%wireferry.downloadWhenOpenInRemoteExplorer.description%"
        },
        "wireferry.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%wireferry.checkForUpdates.description%",
          "deprecationMessage": "%wireferry.checkForUpdates.deprecation%"
        },
        "wireferry.suppressLegacyConfigNotice": {
          "type": "boolean",
          "default": false,
          "description": "%wireferry.suppressLegacyConfigNotice.description%"
        },
        "wireferry.alertLanguage": {
          "type": "string",
          "enum": [
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "English",
            "Русский"
          ],
          "default": "en",
          "description": "%wireferry.alertLanguage.description%"
        },
        "wireferry.remoteExplorer.showSize": {
          "type": "boolean",
          "default": false,
          "description": "%wireferry.remoteExplorer.showSize.description%"
        },
        "wireferry.remoteExplorer.sortBySize": {
          "type": "boolean",
          "default": false,
          "description": "%wireferry.remoteExplorer.sortBySize.description%"
        },
        "wireferry.remoteExplorer.profilesAsRoots": {
          "type": "boolean",
          "default": true,
          "description": "%wireferry.remoteExplorer.profilesAsRoots.description%"
        }
      }
    },
    "colors": [
      {
        "id": "wireferry.localOnlyForeground",
        "description": "Remote Explorer: foreground for a local-only (L) entry — you created it locally and it isn't on the server yet (green, like a new/untracked file).",
        "defaults": {
          "dark": "#73c991",
          "light": "#388a34",
          "highContrast": "#73c991",
          "highContrastLight": "#388a34"
        }
      },
      {
        "id": "wireferry.remoteOnlyForeground",
        "description": "Remote Explorer: foreground for a remote-only (R) entry — it lives on the server with no local copy (blue, \"parked\" on the server).",
        "defaults": {
          "dark": "#3794ff",
          "light": "#0066bf",
          "highContrast": "#3794ff",
          "highContrastLight": "#0066bf"
        }
      }
    ],
    "commands": [
      {
        "command": "wireferry.config",
        "title": "%wireferry.config%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.setProfile",
