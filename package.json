      "explorer/context": [
        {
          "command": "wireferry.sync.localToRemote",
          "group": "wireferry.sync@1",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.sync.remoteToLocal",
          "group": "wireferry.sync@2",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.sync.bothDirections",
          "group": "wireferry.sync@3",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.file",
          "group": "wireferry.trans@1",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.folder",
          "group": "wireferry.trans@1",
          "alt": "wireferry.forceUpload",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.file.to.allProfiles",
          "group": "wireferry.trans@1",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.folder.to.allProfiles",
          "group": "wireferry.trans@1",
          "alt": "wireferry.forceUpload.to.allProfiles",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.download.file",
          "group": "wireferry.trans@2",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.download.folder",
          "group": "wireferry.trans@2",
          "alt": "wireferry.forceDownload",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.copyPathAsGitBash",
          "group": "9_cutcopypaste@10",
          "when": "wireferry.enabled"
        },
        {
          "submenu": "wireferry.explorerMenu",
          "group": "wireferry.trans@9",
          "when": "wireferry.enabled"
        }
      ],
      "wireferry.explorerMenu": [
        {
          "command": "wireferry.config",
          "group": "1_view@1",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.revealInRemoteExplorer",
          "group": "1_view@2",
          "when": "wireferry.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "wireferry.tree",
          "group": "2_info@1",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.remoteExplorer.calculateFolderSize",
          "group": "2_info@2",
          "when": "wireferry.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "wireferry.diff",
          "group": "2_info@3",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.delete.remote",
          "group": "3_modification@1",
          "when": "wireferry.enabled && !explorerResourceIsRoot"
        }
      ],
      "editor/context": [
        {
          "command": "wireferry.upload.file",
          "group": "wireferry.trans@1",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.upload.file.to.allProfiles",
          "group": "wireferry.trans@2",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.download.file",
          "group": "wireferry.trans@3",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.diff",
          "group": "wireferry.trans@4",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.remoteExplorer.editInLocal",
          "group": "wireferry.trans@5",
          "when": "wireferry.enabled && resourceScheme == remote"
        }
      ],
      "editor/title": [
        {
          "command": "wireferry.remoteExplorer.refreshActiveFile",
          "group": "navigation",
          "when": "wireferry.enabled && resourceScheme == remote"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "wireferry.tabMenu",
          "group": "2_files",
          "when": "wireferry.enabled && (resourceScheme == file || resourceScheme == remote)"
        }
      ],
      "wireferry.tabMenu": [
        {
          "command": "wireferry.revealInExplorer",
          "group": "1_reveal@1",
          "when": "wireferry.enabled && resourceScheme == remote"
        },
        {
          "command": "wireferry.revealInRemoteExplorer",
          "group": "1_reveal@1",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.delete.remote",
          "group": "2_modification@1",
          "when": "wireferry.enabled && resourceScheme == file"
        }
      ],
      "view/title": [
        {
          "command": "wireferry.remoteExplorer.openByPath",
          "when": "view == remoteExplorer && wireferry.hasConfig",
          "group": "navigation@1"
        },
        {
          "command": "wireferry.remoteExplorer.refresh",
          "when": "view == remoteExplorer && wireferry.hasConfig",
          "group": "navigation@2"
        },
        {
          "command": "wireferry.upload.modifiedFromTree",
          "when": "view == remoteExplorer && wireferry.hasConfig",
          "group": "navigation@3"
        },
        {
          "command": "wireferry.remoteExplorer.sortTreeBySize",
          "when": "view == remoteExplorer && wireferry.hasConfig && !config.wireferry.remoteExplorer.sortBySize",
          "group": "navigation@4"
        },
        {
          "command": "wireferry.remoteExplorer.sortTreeByName",
          "when": "view == remoteExplorer && wireferry.hasConfig && config.wireferry.remoteExplorer.sortBySize",
          "group": "navigation@4"
        },
        {
          "command": "wireferry.remoteExplorer.showSizes",
          "when": "view == remoteExplorer && wireferry.hasConfig && !config.wireferry.remoteExplorer.showSize && !wireferry.measuringSizes",
          "group": "navigation@5"
        },
        {
          "command": "wireferry.remoteExplorer.hideSizes",
          "when": "view == remoteExplorer && wireferry.hasConfig && config.wireferry.remoteExplorer.showSize && !wireferry.measuringSizes",
          "group": "navigation@5"
        },
        {
          "command": "wireferry.remoteExplorer.measuringSizes",
          "when": "view == remoteExplorer && wireferry.hasConfig && wireferry.measuringSizes",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "wireferry.openConnectInTerminal",
          "group": "navigation@1",
          "when": "view == remoteExplorer && viewItem =~ /^root/"
        },
        {
          "command": "wireferry.openExtensionPage",
          "group": "navigation@2",
          "when": "view == remoteExplorer && viewItem =~ /^root/"
        },
        {
          "command": "wireferry.checkForUpdatesNow",
          "group": "navigation@3",
          "when": "view == remoteExplorer && viewItem =~ /^root/"
        },
        {
          "command": "wireferry.deleteSavedPassword",
          "group": "navigation@4",
          "when": "view == remoteExplorer && viewItem =~ /^root/"
        },
        {
          "command": "wireferry.generateSshKey",
          "group": "navigation@5",
          "when": "view == remoteExplorer && viewItem =~ /^root\\.sftp/"
        },
        {
          "command": "wireferry.savePasswordToKeychain",
          "group": "navigation@6",
          "when": "view == remoteExplorer && viewItem =~ /^root\\.(sftp|ftp)/"
        },
        {
          "command": "wireferry.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem =~ /^file(Synced|RemoteOnly)?$/ && !config.wireferry.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "wireferry.viewContent",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem =~ /^file(Synced|RemoteOnly)?$/ && config.wireferry.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "wireferry.revealInExplorer",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem =~ /^(file|folder)(Synced|LocalOnly)?$/"
        },
        {
          "command": "wireferry.remoteExplorer.copyPath",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem =~ /^(file|folder)(Synced|RemoteOnly|LocalOnly)?$/"
        },
        {
          "command": "wireferry.remoteExplorer.viewAsRoot",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem =~ /^(file|folder)(Synced|RemoteOnly)?$/"
        },
        {
          "command": "wireferry.remoteExplorer.calculateFolderSize",
          "group": "2_files",
          "when": "view == remoteExplorer"
        },
        {
          "command": "wireferry.tree",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem =~ /^folder(Synced|RemoteOnly)?$|^root/"
        },
        {
          "command": "wireferry.remoteExplorer.recheckModified",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem =~ /^folder(Synced|RemoteOnly)?$|^root/"
        },
        {
          "command": "wireferry.upload.folder",
          "group": "3_trans@1",
          "alt": "wireferry.forceUpload",
          "when": "wireferry.enabled && viewItem =~ /^folder(Synced|LocalOnly)?$|^root/"
        },
        {
          "command": "wireferry.upload.file",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem =~ /^file(LocalOnly)?$/"
        },
        {
          "command": "wireferry.upload.file.synced",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem == fileSynced"
        },
        {
          "command": "wireferry.upload.folder.to.allProfiles",
          "group": "3_trans@1",
          "alt": "wireferry.forceUpload.to.allProfiles",
          "when": "wireferry.enabled && viewItem =~ /^folder(Synced|LocalOnly)?$|^root/"
        },
        {
          "command": "wireferry.upload.file.to.allProfiles",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem =~ /^file(LocalOnly)?$/"
        },
        {
          "command": "wireferry.download.folder",
          "group": "3_trans@2",
          "alt": "wireferry.forceDownload",
          "when": "wireferry.enabled && viewItem =~ /^folder(Synced|RemoteOnly)?$|^root/"
        },
        {
          "command": "wireferry.download.file",
          "group": "3_trans@2",
          "when": "view == remoteExplorer && viewItem =~ /^file(RemoteOnly)?$/"
        },
        {
          "command": "wireferry.download.file.synced",
          "group": "3_trans@2",
          "when": "view == remoteExplorer && viewItem == fileSynced"
        },
        {
          "command": "wireferry.rename",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem =~ /^(file|folder)(Synced|RemoteOnly)?$/"
        },
        {
          "command": "wireferry.delete.remote",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem =~ /^(file|folder)(Synced|RemoteOnly|LocalOnly)?$/"
        },
        {
          "command": "wireferry.chmod.remote",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem =~ /^(file|folder)(Synced|RemoteOnly)?$/"
        },
        {
          "command": "wireferry.chown.remote",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem =~ /^(file|folder)(Synced|RemoteOnly)?$/"
        },
        {
          "command": "wireferry.create.folder",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem =~ /^folder(Synced|RemoteOnly)?$|^root/"
        },
        {
          "command": "wireferry.create.file",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem =~ /^folder(Synced|RemoteOnly)?$|^root/"
        },
        {
          "command": "wireferry.download.file",
          "group": "inline",
          "when": "view == remoteExplorer && viewItem =~ /^file(RemoteOnly)?$/"
        },
        {
          "command": "wireferry.download.folder",
          "group": "inline",
          "when": "wireferry.enabled && view == remoteExplorer && viewItem =~ /^folder(RemoteOnly)?$/"
        }
      ],
      "scm/title": [
        {
          "command": "wireferry.upload.changedFiles",
          "group": "wireferry",
          "when": "wireferry.enabled && scmProvider == git && !gitFreshRepository"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "wireferry.upload.changedFiles",
          "group": "inline",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "wireferry.upload.changedFiles",
          "group": "wireferry",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "wireferry.upload.changedFiles",
          "group": "inline",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        },
        {
          "command": "wireferry.upload.changedFiles",
          "group": "wireferry",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remoteExplorer",
        "contents": "%view.remoteExplorer.welcome%",
        "when": "!wireferry.hasConfig"
      }
    ],
    "keybindings": [
      {
        "command": "wireferry.upload.changedFiles",
        "key": "ctrl+alt+u",
        "when": "wireferry.enabled"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/config.schema.json"
      },
      {
        "fileMatch": ".vscode/wireferry.json",
        "url": "./schema/config.schema.json"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "remote",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "dev": "webpack --mode development --watch",
