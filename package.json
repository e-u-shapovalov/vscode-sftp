{
  "name": "wireferry",
  "displayName": "WireFerry — SFTP & FTP Sync",
  "description": "%extension.description%",
  "version": "2.0.8",
  "publisher": "EvgeniiShapovalov",
  "author": "EvgeniiShapovalov (https://github.com/e-u-shapovalov)",
  "engines": {
    "vscode": "^1.66.0"
  },
  "bugs": {
    "url": "https://github.com/e-u-shapovalov/vscode-sftp/issues"
  },
  "homepage": "https://github.com/e-u-shapovalov/vscode-sftp/blob/develop/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-u-shapovalov/vscode-sftp.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ftp",
    "ftps",
    "ssh",
    "sync",
    "upload",
    "download",
    "deploy",
    "remote",
    "remote-edit",
    "file-sync",
    "wireferry"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:wireferry.config",
    "workspaceContains:.vscode/sftp.json",
    "workspaceContains:.vscode/wireferry.json"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wireferry",
          "title": "WireFerry",
          "icon": "resources/remote-explorer.svg"
        }
      ]
    },
    "views": {
      "wireferry": [
        {
          "id": "remoteExplorer",
          "name": "%view.remoteExplorer.name%",
          "when": "wireferry.enabled"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "WireFerry",
      "properties": {
        "wireferry.debug": {
          "type": "boolean",
          "default": false,
          "description": "%wireferry.debug.description%"
        },
        "wireferry.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "%wireferry.downloadWhenOpenInRemoteExplorer.description%"
        },
        "wireferry.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%wireferry.checkForUpdates.description%"
        },
        "wireferry.suppressLegacyConfigNotice": {
          "type": "boolean",
          "default": false,
          "description": "%wireferry.suppressLegacyConfigNotice.description%"
        },
        "wireferry.alertLanguage": {
          "type": "string",
          "enum": [
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "English",
            "Русский"
          ],
          "default": "en",
          "description": "%wireferry.alertLanguage.description%"
        }
      }
    },
    "commands": [
      {
        "command": "wireferry.config",
        "title": "%wireferry.config%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.setProfile",
        "title": "%wireferry.setProfile%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.openConnectInTerminal",
        "title": "%wireferry.openConnectInTerminal%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.openExtensionPage",
        "title": "%wireferry.openExtensionPage%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.checkForUpdatesNow",
        "title": "%wireferry.checkForUpdatesNow%",
        "category": "WireFerry",
        "icon": "$(cloud-download)"
      },
      {
        "command": "wireferry.cancelAllTransfer",
        "title": "%wireferry.cancelAllTransfer%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.file",
        "title": "%wireferry.upload.file%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.changedFiles",
        "title": "%wireferry.upload.changedFiles%",
        "category": "WireFerry",
        "icon": {
          "light": "resources/light/upload.svg",
          "dark": "resources/dark/upload.svg"
        }
      },
      {
        "command": "wireferry.upload.activeFile",
        "title": "%wireferry.upload.activeFile%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.folder",
        "title": "%wireferry.upload.folder%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.activeFolder",
        "title": "%wireferry.upload.activeFolder%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.project",
        "title": "%wireferry.upload.project%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.forceUpload",
        "title": "%wireferry.forceUpload%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.file.to.allProfiles",
        "title": "%wireferry.upload.file.to.allProfiles%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.activeFile.to.allProfiles",
        "title": "%wireferry.upload.activeFile.to.allProfiles%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.folder.to.allProfiles",
        "title": "%wireferry.upload.folder.to.allProfiles%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.activeFolder.to.allProfiles",
        "title": "%wireferry.upload.activeFolder.to.allProfiles%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.upload.project.to.allProfiles",
        "title": "%wireferry.upload.project.to.allProfiles%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.forceUpload.to.allProfiles",
        "title": "%wireferry.forceUpload.to.allProfiles%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.download.file",
        "title": "%wireferry.download.file%",
        "category": "WireFerry",
        "icon": {
          "dark": "resources/dark/download-file.svg",
          "light": "resources/light/download-file.svg"
        }
      },
      {
        "command": "wireferry.download.activeFile",
        "title": "%wireferry.download.activeFile%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.download.folder",
        "title": "%wireferry.download.folder%",
        "category": "WireFerry",
        "icon": {
          "dark": "resources/dark/download-folder.svg",
          "light": "resources/light/download-folder.svg"
        }
      },
      {
        "command": "wireferry.download.activeFolder",
        "title": "%wireferry.download.activeFolder%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.download.project",
        "title": "%wireferry.download.project%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.forceDownload",
        "title": "%wireferry.forceDownload%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.sync.localToRemote",
        "title": "%wireferry.sync.localToRemote%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.sync.remoteToLocal",
        "title": "%wireferry.sync.remoteToLocal%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.sync.bothDirections",
        "title": "%wireferry.sync.bothDirections%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.diff",
        "title": "%wireferry.diff%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.diff.activeFile",
        "title": "%wireferry.diff.activeFile%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.list",
        "title": "%wireferry.list%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.listActiveFolder",
        "title": "%wireferry.listActiveFolder%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.listAll",
        "title": "%wireferry.listAll%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.rename",
        "title": "%wireferry.rename%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.delete.remote",
        "title": "%wireferry.delete.remote%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.create.folder",
        "title": "%wireferry.create.folder%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.create.file",
        "title": "%wireferry.create.file%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.revealInExplorer",
        "title": "%wireferry.revealInExplorer%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.revealInRemoteExplorer",
        "title": "%wireferry.revealInRemoteExplorer%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.remoteExplorer.editInLocal",
        "title": "%wireferry.remoteExplorer.editInLocal%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.viewContent",
        "title": "%wireferry.viewContent%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.remoteExplorer.copyPath",
        "title": "%wireferry.remoteExplorer.copyPath%",
        "category": "WireFerry"
      },
      {
        "command": "wireferry.remoteExplorer.refresh",
        "title": "%wireferry.remoteExplorer.refresh%",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "wireferry.remoteExplorer.refreshActiveFile",
        "title": "%wireferry.remoteExplorer.refreshActiveFile%",
        "category": "WireFerry",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "wireferry.remoteExplorer.openByPath",
        "title": "%wireferry.remoteExplorer.openByPath%",
        "category": "WireFerry",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "wireferry.setProfile",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.openConnectInTerminal",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.openExtensionPage",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.cancelAllTransfer",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.activeFile",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.activeFolder",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.project",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.activeFile.to.allProfiles",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.activeFolder.to.allProfiles",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.project.to.allProfiles",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.download.activeFile",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.download.activeFolder",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.download.project",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.sync.localToRemote",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.sync.remoteToLocal",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.sync.bothDirections",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.diff.activeFile",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.list",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.listActiveFolder",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.listAll",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.file",
          "when": "false"
        },
        {
          "command": "wireferry.upload.changedFiles",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.upload.folder",
          "when": "false"
        },
        {
          "command": "wireferry.forceUpload",
          "when": "false"
        },
        {
          "command": "wireferry.upload.file.to.allProfiles",
          "when": "false"
        },
        {
          "command": "wireferry.upload.folder.to.allProfiles",
          "when": "false"
        },
        {
          "command": "wireferry.forceUpload.to.allProfiles",
          "when": "false"
        },
        {
          "command": "wireferry.download.file",
          "when": "false"
        },
        {
          "command": "wireferry.download.folder",
          "when": "false"
        },
        {
          "command": "wireferry.forceDownload",
          "when": "false"
        },
        {
          "command": "wireferry.diff",
          "when": "false"
        },
        {
          "command": "wireferry.rename",
          "when": "false"
        },
        {
          "command": "wireferry.delete.remote",
          "when": "false"
        },
        {
          "command": "wireferry.create.folder",
          "when": "false"
        },
        {
          "command": "wireferry.create.file",
          "when": "false"
        },
        {
          "command": "wireferry.revealInExplorer",
          "when": "false"
        },
        {
          "command": "wireferry.revealInRemoteExplorer",
          "when": "false"
        },
        {
          "command": "wireferry.remoteExplorer.editInLocal",
          "when": "false"
        },
        {
          "command": "wireferry.viewContent",
          "when": "false"
        },
        {
          "command": "wireferry.remoteExplorer.copyPath",
          "when": "false"
        },
        {
          "command": "wireferry.remoteExplorer.openByPath",
          "when": "wireferry.enabled"
        },
        {
          "command": "wireferry.remoteExplorer.refresh",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "wireferry.config",
          "group": "navigation@19",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.revealInRemoteExplorer",
          "group": "navigation@20",
          "when": "wireferry.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "wireferry.diff",
          "group": "3_compare",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.sync.localToRemote",
          "group": "wireferry.sync@1",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.sync.remoteToLocal",
          "group": "wireferry.sync@2",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.sync.bothDirections",
          "group": "wireferry.sync@3",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.file",
          "group": "wireferry.trans@1",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.folder",
          "group": "wireferry.trans@1",
          "alt": "wireferry.forceUpload",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.file.to.allProfiles",
          "group": "wireferry.trans@1",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.upload.folder.to.allProfiles",
          "group": "wireferry.trans@1",
          "alt": "wireferry.forceUpload.to.allProfiles",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        },
        {
          "command": "wireferry.download.file",
          "group": "wireferry.trans@2",
          "when": "wireferry.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "wireferry.download.folder",
          "group": "wireferry.trans@2",
          "alt": "wireferry.forceDownload",
          "when": "wireferry.enabled && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "wireferry.upload.file",
          "group": "wireferry.trans@1",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.upload.file.to.allProfiles",
          "group": "wireferry.trans@1",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.download.file",
          "group": "wireferry.trans@2",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.diff",
          "group": "3_compare",
          "when": "wireferry.enabled && resourceScheme == file"
        },
        {
          "command": "wireferry.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "wireferry.enabled && resourceScheme == remote"
        }
      ],
      "editor/title": [
        {
          "command": "wireferry.remoteExplorer.refreshActiveFile",
          "group": "navigation",
          "when": "wireferry.enabled && resourceScheme == remote"
        }
      ],
      "editor/title/context": [
        {
          "command": "wireferry.revealInExplorer",
          "group": "2_files",
          "when": "wireferry.enabled && resourceScheme == remote"
        },
        {
          "command": "wireferry.revealInRemoteExplorer",
          "when": "wireferry.enabled && resourceScheme == file",
          "group": "2_files"
        }
      ],
      "view/title": [
        {
          "command": "wireferry.remoteExplorer.openByPath",
          "when": "view == remoteExplorer",
          "group": "navigation@1"
        },
        {
          "command": "wireferry.remoteExplorer.refresh",
          "when": "view == remoteExplorer",
          "group": "navigation@2"
        },
        {
          "command": "wireferry.checkForUpdatesNow",
          "when": "view == remoteExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "wireferry.openConnectInTerminal",
          "group": "navigation@1",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "wireferry.openExtensionPage",
          "group": "navigation@2",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "wireferry.checkForUpdatesNow",
          "group": "navigation@3",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "wireferry.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && !config.wireferry.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "wireferry.viewContent",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && config.wireferry.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "wireferry.revealInExplorer",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "wireferry.remoteExplorer.copyPath",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "wireferry.upload.folder",
          "group": "3_trans@1",
          "alt": "wireferry.forceUpload",
          "when": "wireferry.enabled && viewItem != file"
        },
        {
          "command": "wireferry.upload.file",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "wireferry.upload.folder.to.allProfiles",
          "group": "3_trans@1",
          "alt": "wireferry.forceUpload.to.allProfiles",
          "when": "wireferry.enabled && viewItem != file"
        },
        {
          "command": "wireferry.upload.file.to.allProfiles",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "wireferry.download.folder",
          "group": "3_trans@2",
          "alt": "wireferry.forceDownload",
          "when": "wireferry.enabled && viewItem != file"
        },
        {
          "command": "wireferry.download.file",
          "group": "3_trans@2",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "wireferry.rename",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "wireferry.delete.remote",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "wireferry.create.folder",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file"
        },
        {
          "command": "wireferry.create.file",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file"
        },
        {
          "command": "wireferry.download.file",
          "group": "inline",
          "when": "view == remoteExplorer && viewItem == file"
        },
        {
          "command": "wireferry.download.folder",
          "group": "inline",
          "when": "wireferry.enabled && view == remoteExplorer && viewItem == folder"
        }
      ],
      "scm/title": [
        {
          "command": "wireferry.upload.changedFiles",
          "group": "wireferry",
          "when": "wireferry.enabled && scmProvider == git && !gitFreshRepository"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "wireferry.upload.changedFiles",
          "group": "inline",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "wireferry.upload.changedFiles",
          "group": "wireferry",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "wireferry.upload.changedFiles",
          "group": "inline",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        },
        {
          "command": "wireferry.upload.changedFiles",
          "group": "wireferry",
          "when": "wireferry.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        }
      ]
    },
    "keybindings": [
      {
        "command": "wireferry.upload.changedFiles",
        "key": "ctrl+alt+u",
        "when": "wireferry.enabled"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/config.schema.json"
      },
      {
        "fileMatch": ".vscode/wireferry.json",
        "url": "./schema/config.schema.json"
      }
    ],
